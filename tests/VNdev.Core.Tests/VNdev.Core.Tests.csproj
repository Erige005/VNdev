<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>VNdev.Core.Tests</RootNamespace>
    <!--
      Chạy bằng `dotnet run`, không dùng xUnit hay NUnit. Bộ test phải chạy
      được trên máy sạch chỉ với .NET SDK, không cần tải gói NuGet nào.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/VNdev.Core/VNdev.Core.csproj" />
  </ItemGroup>

</Project>
