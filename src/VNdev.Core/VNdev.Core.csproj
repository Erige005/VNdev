<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <RootNamespace>VNdev.Core</RootNamespace>
    <!--
      Lõi cố tình KHÔNG tham chiếu Godot. Cùng một bộ code này phải chạy được
      trong editor, trong game xuất ra, và trong bộ test chạy bằng dotnet test
      mà không cần mở engine. Thêm phụ thuộc Godot vào đây là phá vỡ điều đó.
    -->
  </PropertyGroup>

</Project>
